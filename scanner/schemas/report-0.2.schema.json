{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dogwatch:schema:report:0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "scanner", "policy", "findings", "diagnostics"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "status": {"enum": ["pass", "fail", "inconclusive"]},
    "scanner": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {
        "name": {"const": "dogwatch"},
        "version": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\\\u0000-\\u001f]+$"},
        "digest": {
          "type": "object", "additionalProperties": false, "required": ["sha256"],
          "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "severity": {"enum": ["error", "warning", "info"]},
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "check_id", "severity", "message", "fingerprint", "waiver", "locator"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "check_id": {"type": "string", "minLength": 1},
        "severity": {"$ref": "#/$defs/severity"},
        "message": {"type": "string"},
        "fingerprint": {"type": "string", "minLength": 1},
        "waiver": {"type": "null"},
        "locator": {"$ref": "#/$defs/locator"}
      }
    },
    "locator": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "source_module": {"type": "string", "minLength": 1},
        "target_module": {"type": "string", "minLength": 1}
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "id", "severity", "message"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"},
        "severity": {"$ref": "#/$defs/severity"},
        "message": {"type": "string"}
      }
    }
  }
}
